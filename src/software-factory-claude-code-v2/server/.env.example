# Copy to .env and fill in. Never commit .env.

# The one repository this factory builds, as owner/name. It must already have
# the factory installed on its default branch (see ../INSTALL.md).
GITHUB_REPO=

# A fine-grained personal access token limited to that repository, with
# read and write on Contents, Issues and Pull requests.
GH_TOKEN=

# The secret you give the GitHub webhook. Generate one: openssl rand -hex 32
WEBHOOK_SECRET=

# Claude credentials: one of the two.
# An API key bills per token. A token from `claude setup-token` uses your plan.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. Set a password to serve the dashboard at /dashboard/ (any user name).
DASHBOARD_PASSWORD=

# Optional. Your domain, for `docker compose --profile tls`.
DOMAIN=

# Optional. Seconds one headless run may take before it is stopped (default 3 hours).
# FACTORY_RUN_TIMEOUT=10800

# Optional. Flags for `claude -p "/factory run"`. The default lets the session
# use Bash, the file tools and subagents without asking, and nothing else.
# FACTORY_CLAUDE_ARGS=--permission-mode acceptEdits --allowedTools Bash,Read,Write,Edit,Grep,Glob,Agent,SendMessage,Skill
