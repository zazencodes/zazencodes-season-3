{
  "name": "neon-meal-helper-agent",
  "version": "1.0.0",
  "description": "Meal planning agent on Neon",
  "scripts": {
    "dev:api": "neon dev --source src/server/index.ts --port 8787",
    "dev:web": "vite",
    "build:web": "vite build",
    "db:migrate": "node --env-file=.env.local scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "deploy:api": "neon deploy --env .env.local"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/lib-storage": "^3.1144.0",
    "@aws-sdk/s3-presigned-post": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@earendil-works/pi-agent-core": "^0.99.2",
    "@earendil-works/pi-ai": "^0.99.2",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@neon/functions": "^0.11.0",
    "@neondatabase/auth": "^0.5.0-beta",
    "files-sdk": "^2.6.2",
    "hono": "^4.13.12",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "neon": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  },
  "private": true
}
